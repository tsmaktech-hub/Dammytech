// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: userId (matches Auth UID)
// Fields:
//   - id: string (required) - The UID of the user
//   - username: string (required) - Display name
//   - full_name: string (optional) - Full name
//   - phone_number: string (optional) - Contact number
//   - avatar_url: string (optional) - Profile picture URL
//   - role: string (required, enum: ['user', 'admin']) - User role
//   - updated_at: timestamp (required) - Last update time
//
// Collection: gadgets
// Document ID: gadgetId (auto-generated)
// Fields:
//   - id: string (required) - Gadget ID
//   - name: string (required, max 100 chars) - Gadget name
//   - description: string (required, max 1000 chars) - Description
//   - price: number (required, positive) - Price
//   - category: string (required) - Category
//   - image: string (required, valid URL) - Image URL
//   - author: string (required) - UID of the creator
//   - created_at: timestamp (required) - Creation time
//   - updated_at: timestamp (required) - Update time
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == 'dammy') ||
         request.auth.token.email.lower() == "tsmaktech@gmail.com"); 
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['id', 'username', 'role', 'updated_at']) &&
             data.id == request.auth.uid &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.role in ['user', 'admin'] &&
             data.updated_at is timestamp;
    }

    function isValidGadget(data) {
      return hasRequiredFields(['name', 'description', 'price', 'category', 'image', 'author', 'created_at', 'updated_at']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.price is number && data.price > 0 &&
             data.category is string &&
             isValidUrl(data.image) &&
             data.author is string &&
             data.created_at is timestamp &&
             data.updated_at is timestamp;
    }

    function isValidOrder(data) {
      return hasRequiredFields(['gadget_id', 'user_id', 'status', 'created_at', 'updated_at', 'user_name', 'gadget_name', 'gadget_image']) &&
             data.gadget_id is string &&
             data.user_id is string &&
             data.status in ['ordered', 'delivered'] &&
             data.user_name is string &&
             data.gadget_name is string &&
             isValidUrl(data.gadget_image) &&
             data.created_at is timestamp &&
             data.updated_at is timestamp;
    }

    function isValidTestimonial(data) {
      return hasRequiredFields(['user_id', 'name', 'text', 'rating', 'created_at']) &&
             data.user_id == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.created_at is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data) && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    match /gadgets/{gadgetId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidGadget(request.resource.data) && request.resource.data.author == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.author == request.auth.uid || isAdmin()) && isValidGadget(request.resource.data) && request.resource.data.author == resource.data.author && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isAuthenticated() && (resource.data.author == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidOrder(request.resource.data) && request.resource.data.user_id == request.auth.uid && request.resource.data.status == 'ordered';
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(resource.data.user_id) && request.resource.data.status == resource.data.status)) && isValidOrder(request.resource.data);
      allow delete: if isAuthenticated() && (isOwner(resource.data.user_id) || isAdmin());
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidTestimonial(request.resource.data);
      allow update: if isAuthenticated() && isOwner(resource.data.user_id) && isValidTestimonial(request.resource.data) && request.resource.data.user_id == resource.data.user_id;
      allow delete: if isAuthenticated() && (isOwner(resource.data.user_id) || isAdmin());
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
