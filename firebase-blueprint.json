{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores extended information about the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the user (matches Auth UID)." },
        "username": { "type": "string", "description": "Display name or handle." },
        "full_name": { "type": "string", "description": "User's full name." },
        "phone_number": { "type": "string", "description": "User's contact number." },
        "avatar_url": { "type": "string", "description": "URL to the user's profile picture." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User's role in the system." },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["id", "username"]
    },
    "Gadget": {
      "title": "Gadget",
      "description": "Represents a gadget listed in the store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the gadget." },
        "name": { "type": "string", "description": "Name of the gadget." },
        "description": { "type": "string", "description": "Detailed description of the gadget." },
        "price": { "type": "number", "description": "Price of the gadget." },
        "category": { "type": "string", "description": "Category (e.g., phones, laptops)." },
        "image": { "type": "string", "description": "URL to the gadget image." },
        "author": { "type": "string", "description": "UID of the user who listed the gadget." },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["name", "price", "category", "author"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents an order made by a user for a gadget.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the order." },
        "gadget_id": { "type": "string", "description": "ID of the ordered gadget." },
        "user_id": { "type": "string", "description": "ID of the user who made the order." },
        "user_name": { "type": "string", "description": "Name of the user who ordered." },
        "gadget_name": { "type": "string", "description": "Name of the gadget." },
        "gadget_image": { "type": "string", "description": "Image URL of the gadget." },
        "status": { "type": "string", "enum": ["ordered", "delivered"], "description": "Status of the order." },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["gadget_id", "user_id", "status"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "User feedback or testimonials.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the testimonial." },
        "user_id": { "type": "string", "description": "ID of the user who wrote the testimonial." },
        "name": { "type": "string", "description": "Name of the reviewer." },
        "role": { "type": "string", "description": "Role of the reviewer (e.g., Designer, Developer)." },
        "text": { "type": "string", "description": "The testimonial content." },
        "avatar": { "type": "string", "description": "Initials or avatar URL." },
        "rating": { "type": "number", "description": "Rating out of 5." },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["user_id", "name", "text", "rating"]
    },
    "VerificationCode": {
      "title": "Verification Code",
      "description": "Temporary codes for email verification during signup.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "The 6-digit verification code." },
        "expires": { "type": "string", "format": "date-time", "description": "Expiry timestamp." }
      },
      "required": ["code", "expires"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles."
    },
    "/gadgets/{gadgetId}": {
      "schema": "Gadget",
      "description": "Collection of gadgets available in the store."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders."
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Collection of user testimonials."
    },
    "/verification_codes/{email}": {
      "schema": "VerificationCode",
      "description": "Collection of temporary verification codes."
    }
  }
}
